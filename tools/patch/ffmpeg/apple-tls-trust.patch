+#ifndef AVFORMAT_TLS_APPLE_H
+#define AVFORMAT_TLS_APPLE_H
+
+#ifdef __APPLE__
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <Security/SecCertificate.h>
+#include <Security/SecPolicy.h>
+#include <Security/SecTrust.h>
+
+#include "libavutil/attributes.h"
+#include "libavutil/error.h"
+#include "libavutil/log.h"
+#include "libavutil/macros.h"
+#include "libavutil/mem.h"
+#include "tls.h"
+
+/*
+ * On iOS neither OpenSSL nor GnuTLS can find the system's root certificates
+ * (there is no API to list them), and on macOS OpenSSL can't either. So a
+ * client that verifies its peer without a ca_file hands the chain to the
+ * system's trust store instead, which also applies user- and MDM-installed
+ * roots and Apple's distrust decisions. A ca_file keeps the library's own
+ * checks.
+ */
+static av_unused int ff_tls_apple_trust_applies(const TLSShared *s)
+{
+    return s->verify && !s->ca_file && !s->listen && !s->is_dtls;
+}
+
+/**
+ * Check a peer's certificate chain, DER-encoded with the leaf first, for the
+ * TLS server name host, against the system's trust store.
+ *
+ * @return 0 if the chain is trusted for host, AVERROR(EIO) otherwise (logged)
+ */
+static av_unused int ff_tls_apple_verify(void *log_ctx, const void *const *der,
+                                         const size_t *der_size, int nb_certs,
+                                         const char *host)
+{
+    CFMutableArrayRef certs = NULL;
+    CFStringRef cf_host = NULL;
+    SecPolicyRef policy = NULL;
+    SecTrustRef trust = NULL;
+    CFErrorRef error = NULL;
+    int ret = AVERROR(EIO);
+
+    if (nb_certs <= 0) {
+        av_log(log_ctx, AV_LOG_ERROR, "Peer sent no certificate\n");
+        return ret;
+    }
+    certs = CFArrayCreateMutable(kCFAllocatorDefault, nb_certs, &kCFTypeArrayCallBacks);
+    if (!certs)
+        goto fail;
+    for (int i = 0; i < nb_certs; i++) {
+        CFDataRef data = CFDataCreate(kCFAllocatorDefault, (const UInt8 *)der[i], der_size[i]);
+        SecCertificateRef cert = data ? SecCertificateCreateWithData(kCFAllocatorDefault, data) : NULL;
+        if (data)
+            CFRelease(data);
+        if (!cert) {
+            av_log(log_ctx, AV_LOG_ERROR, "Unable to read the peer certificate chain\n");
+            goto end;
+        }
+        CFArrayAppendValue(certs, cert);
+        CFRelease(cert);
+    }
+    cf_host = CFStringCreateWithCString(kCFAllocatorDefault, host, kCFStringEncodingUTF8);
+    if (!cf_host)
+        goto fail;
+    policy = SecPolicyCreateSSL(true, cf_host);
+    if (!policy || SecTrustCreateWithCertificates(certs, policy, &trust) != errSecSuccess)
+        goto fail;
+
+    if (SecTrustEvaluateWithError(trust, &error)) {
+        ret = 0;
+    } else {
+        char reason[512] = "no reason given";
+        CFStringRef desc = error ? CFErrorCopyDescription(error) : NULL;
+        if (desc) {
+            CFStringGetCString(desc, reason, sizeof(reason), kCFStringEncodingUTF8);
+            CFRelease(desc);
+        }
+        av_log(log_ctx, AV_LOG_ERROR, "Peer certificate failed verification: %s\n", reason);
+    }
+    goto end;
+
+fail:
+    av_log(log_ctx, AV_LOG_ERROR, "Unable to check the peer certificate against the system trust store\n");
+end:
+    if (error)
+        CFRelease(error);
+    if (trust)
+        CFRelease(trust);
+    if (policy)
+        CFRelease(policy);
+    if (cf_host)
+        CFRelease(cf_host);
+    if (certs)
+        CFRelease(certs);
+    return ret;
+}
+
+#endif /* __APPLE__ */
+
+#endif /* AVFORMAT_TLS_APPLE_H */
diff --git a/libavformat/tls_gnutls.c b/libavformat/tls_gnutls.c
