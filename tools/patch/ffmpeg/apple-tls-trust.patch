 #include "libavutil/intreadwrite.h"
 #include "libavutil/mem.h"
 #include "libavutil/opt.h"
@@ -530,6 +531,31 @@ end:
     return ret;
 }
 
+#ifdef __APPLE__
+static int gnutls_apple_verify_peer(URLContext *h)
+{
+    TLSContext *c = h->priv_data;
+    unsigned int nb = 0;
+    const gnutls_datum_t *peers = gnutls_certificate_get_peers(c->session, &nb);
+    const void **der = av_calloc(FFMAX(nb, 1), sizeof(*der));
+    size_t *der_size = av_calloc(FFMAX(nb, 1), sizeof(*der_size));
+    int ret = AVERROR(ENOMEM);
+
+    if (der && der_size) {
+        if (!peers)
+            nb = 0;
+        for (unsigned int i = 0; i < nb; i++) {
+            der[i]      = peers[i].data;
+            der_size[i] = peers[i].size;
+        }
+        ret = ff_tls_apple_verify(h, der, der_size, nb, c->tls_shared.host);
+    }
+    av_free(der);
+    av_free(der_size);
+    return ret;
+}
+#endif
