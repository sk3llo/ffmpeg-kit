         if ((ret = gnutls_certificate_verify_peers2(c->session, &status)) < 0) {
             av_log(h, AV_LOG_ERROR, "Unable to verify peer certificate: %s\n",
                                     gnutls_strerror(ret));
diff --git a/libavformat/tls_openssl.c b/libavformat/tls_openssl.c
index 0075288..d09f70c 100644
--- a/libavformat/tls_openssl.c
+++ b/libavformat/tls_openssl.c
@@ -28,6 +28,7 @@
 #include "libavutil/random_seed.h"
 #include "url.h"
 #include "tls.h"
+#include "tls_apple.h"
 #include "libavutil/opt.h"
 
 #include <openssl/bio.h>
@@ -786,6 +787,36 @@ fail:
     return ret;
 }
 
+#ifdef __APPLE__
+static int openssl_apple_verify_peer(URLContext *h)
+{
+    TLSContext *c = h->priv_data;
+    STACK_OF(X509) *chain = SSL_get_peer_cert_chain(c->ssl);
+    int nb = chain ? sk_X509_num(chain) : 0;
+    unsigned char **der = av_calloc(FFMAX(nb, 1), sizeof(*der));
+    size_t *der_size = av_calloc(FFMAX(nb, 1), sizeof(*der_size));
+    int ret = AVERROR(ENOMEM);
+
+    if (!der || !der_size)
+        goto end;
+    for (int i = 0; i < nb; i++) {
+        int len = i2d_X509(sk_X509_value(chain, i), &der[i]);
+        if (len <= 0) {
+            ret = AVERROR(EIO);
+            goto end;
+        }
+        der_size[i] = len;
+    }
+    ret = ff_tls_apple_verify(h, (const void *const *)der, der_size, nb, c->tls_shared.host);
+end:
+    for (int i = 0; der && i < nb; i++)
+        OPENSSL_free(der[i]);
+    av_free(der);
+    av_free(der_size);
+    return ret;
+}
+#endif
+
 static int tls_open(URLContext *h, const char *uri, int flags, AVDictionary **options)
 {
     TLSContext *c = h->priv_data;
